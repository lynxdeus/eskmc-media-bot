# ==========================================
# ESKMC MEDIA BOT - CONFIGURACION
# ==========================================
# IMPORTANTE: Nunca compartas este archivo ni subas el token a GitHub

# 1. Token del Bot (obtenlo en https://discord.com/developers/applications)
DISCORD_TOKEN=tu_token_aqui

# 2. ID de tu servidor de Discord (click derecho en el servidor > Copiar ID)
GUILD_ID=123456789012345678

# 3. ID del rol de Media Manager (click derecho en el rol > Copiar ID)
MEDIA_MANAGER_ROLE_ID=123456789012345678

# 4. ID del rol de Media Staff (click derecho en el rol > Copiar ID)
MEDIA_STAFF_ROLE_ID=123456789012345678

# 5. ID del canal donde se enviaran los logs (click derecho en el canal > Copiar ID)
LOG_CHANNEL_ID=123456789012345678

# ==========================================
# CONFIGURACION OPCIONAL (puedes dejar los valores por defecto)
# ==========================================

# Prefijo de comandos de texto (slash commands usan / automaticamente)
BOT_PREFIX=/

# Ruta de la base de datos (NO modificar recomendado)
DATABASE_PATH=data/eskmc_media.db

# Color de los embeds (formato hexadecimal, ejemplo: 0x5865F2 = azul Discord)
EMBED_COLOR=0x5865F2
